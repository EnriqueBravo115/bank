# Kong exposes each service's actuator at /<service>/actuator (strip_path).
# health and info are public; the rest requires ADMIN.
@kong = http://localhost:8000
@adminToken = PASTE_TOKEN_FROM_auth.http

### user-service health
GET {{kong}}/user/actuator/health

### account-service health
GET {{kong}}/account/actuator/health

### transaction-service health
GET {{kong}}/transaction/actuator/health

### transaction-service info
GET {{kong}}/transaction/actuator/info

### transaction-service circuit breakers (ADMIN)
GET {{kong}}/transaction/actuator/circuitbreakers
Accept: application/json
Authorization: Bearer {{adminToken}}
