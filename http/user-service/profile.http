@baseUrl = http://localhost:8000/api/v1/user/profile
@customerToken = PASTE_TOKEN_FROM_auth.http
@adminToken = PASTE_TOKEN_FROM_auth.http
@userId = 1

### My profile (CUSTOMER_BASIC)
GET {{baseUrl}}/me
Authorization: Bearer {{customerToken}}

### Profile of a user (ADMIN)
GET {{baseUrl}}/get-detail/{{userId}}
Authorization: Bearer {{adminToken}}

### Search by name, paginated (ADMIN)
GET {{baseUrl}}/search/ana?page=0&size=20
Authorization: Bearer {{adminToken}}

### By registration status, paginated (ADMIN)
GET {{baseUrl}}/get-by-status/COMPLETE?page=0&size=20
Authorization: Bearer {{adminToken}}
