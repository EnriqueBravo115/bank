@baseUrl = http://localhost:8000/api/v1/user/profile
@customerToken = PEGA_AQUI_EL_TOKEN_DE_auth.http
@adminToken = PEGA_AQUI_EL_TOKEN_DE_auth.http
@userId = 1

### Mi perfil (CUSTOMER_BASIC)
GET {{baseUrl}}/me
Authorization: Bearer {{customerToken}}

### Perfil de un usuario (ADMIN)
GET {{baseUrl}}/get-detail/{{userId}}
Authorization: Bearer {{adminToken}}

### Buscar por nombre, paginado (ADMIN)
GET {{baseUrl}}/search/ana?page=0&size=20
Authorization: Bearer {{adminToken}}

### Por estado de registro, paginado (ADMIN)
GET {{baseUrl}}/get-by-status/COMPLETE?page=0&size=20
Authorization: Bearer {{adminToken}}
