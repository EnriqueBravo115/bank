@baseUrl = http://localhost:8000/api/v1/user/kyc
@customerToken = PASTE_TOKEN_FROM_auth.http
@adminToken = PASTE_TOKEN_FROM_auth.http
@userId = 1

### My KYC (CUSTOMER_BASIC)
GET {{baseUrl}}/me
Authorization: Bearer {{customerToken}}

### KYC of a user (ADMIN)
GET {{baseUrl}}/get-detail/{{userId}}
Authorization: Bearer {{adminToken}}

### By RFC (ADMIN)
GET {{baseUrl}}/get-by-rfc/MALA920615AB3
Authorization: Bearer {{adminToken}}

### By CURP (ADMIN)
GET {{baseUrl}}/get-by-curp/MALA920615MSLRPN09
Authorization: Bearer {{adminToken}}
