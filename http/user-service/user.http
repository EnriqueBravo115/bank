@baseUrl = http://localhost:8000/api/v1/user
@customerToken = PASTE_TOKEN_FROM_auth.http
@adminToken = PASTE_TOKEN_FROM_auth.http
@userId = 1

### My user (CUSTOMER_BASIC)
GET {{baseUrl}}/me
Authorization: Bearer {{customerToken}}

### User by id (ADMIN)
GET {{baseUrl}}/get-by-id/{{userId}}
Authorization: Bearer {{adminToken}}

### User by email (ADMIN)
GET {{baseUrl}}/get-by-email/ana.martinez92@gmail.com
Authorization: Bearer {{adminToken}}

### Active users, paginated: page from 0, size 1-100 (ADMIN)
GET {{baseUrl}}/get-active?page=0&size=20
Authorization: Bearer {{adminToken}}

### Change the customer tier: CUSTOMER_BASIC, CUSTOMER_PREMIUM or CUSTOMER_BUSINESS (ADMIN)
### The user must log in again to get the new role in their token
PUT {{baseUrl}}/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "CUSTOMER_PREMIUM"
}

### Block: disables the user in Keycloak and freezes their account in account-service (ADMIN)
PUT {{baseUrl}}/{{userId}}/active
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "active": false
}

### Unblock (ADMIN)
PUT {{baseUrl}}/{{userId}}/active
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "active": true
}

### Change my email: it is also the login username; a verification email is sent to http://localhost:8025 (CUSTOMER_BASIC)
PUT {{baseUrl}}/me/email
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "email": "ana.martinez.nuevo@gmail.com"
}

### Change my phone (CUSTOMER_BASIC)
PUT {{baseUrl}}/me/phone
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "phoneCode": "+52",
  "phoneNumber": "6641112233"
}
