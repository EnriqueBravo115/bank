@baseUrl = http://localhost:8000/api/v1/user/financial-info
@customerToken = PASTE_TOKEN_FROM_auth.http
@adminToken = PASTE_TOKEN_FROM_auth.http
@userId = 1

### My financial information (CUSTOMER_BASIC)
GET {{baseUrl}}/me
Authorization: Bearer {{customerToken}}

### Financial information of a user (ADMIN)
GET {{baseUrl}}/get-detail/{{userId}}
Authorization: Bearer {{adminToken}}
