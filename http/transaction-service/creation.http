# The source account must belong to the customer (403 otherwise); an ADMIN can use any account.
# The currency must be the one of the accounts (422 DECLINED otherwise); limits: account-service/limit.http.
# The response has the transactionCode and the status: COMPLETED, DECLINED (rejected by account-service,
# with the reason), FAILED or PENDING (account-service did not answer; it is retried automatically).
@baseUrl = http://localhost:8000/api/v1/transaction/create
@customerToken = PASTE_TOKEN_FROM_auth.http
@adminToken = PASTE_TOKEN_FROM_auth.http
@accountNumber = ACC-1774713408076
@clabe = 002010113717262634
@targetAccountNumber = ACC-1847392018473
@targetClabe = 002180700148685530
# From account-service/card.http (POST /card): number and cvv of a card issued to the account
@cardNumber = 4123450000000001
@cvv = 000

### Transfer - account number to account number
POST {{baseUrl}}/transfer
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "amount": 1500.00,
  "description": "February rent",
  "currency": "MX",
  "sourceIdentifier": "{{accountNumber}}",
  "sourceIdentifierType": "ACCOUNT",
  "targetIdentifier": "{{targetAccountNumber}}",
  "targetIdentifierType": "ACCOUNT"
}

### Transfer - CLABE to CLABE
POST {{baseUrl}}/transfer
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "amount": 100.00,
  "description": "Payment with CLABE",
  "currency": "MX",
  "sourceIdentifier": "{{clabe}}",
  "sourceIdentifierType": "CLABE",
  "targetIdentifier": "{{targetClabe}}",
  "targetIdentifierType": "CLABE"
}

### Transfer - from the account of a card to a CLABE
POST {{baseUrl}}/transfer
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "amount": 50.00,
  "description": "Transfer from the card",
  "currency": "MX",
  "sourceIdentifier": "{{cardNumber}}",
  "sourceIdentifierType": "CARD",
  "targetIdentifier": "{{targetClabe}}",
  "targetIdentifierType": "CLABE"
}

### Card purchase: declined if the card is not linked to the account, is not ACTIVE, is expired or the cvv does not match
POST {{baseUrl}}/purchase
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "amount": 349.99,
  "description": "Department store purchase",
  "sourceAccountNumber": "{{accountNumber}}",
  "sourceCardNumber": "{{cardNumber}}",
  "cvv": "{{cvv}}",
  "merchantCode": "MERC-001",
  "merchantCategory": "RETAIL_CLOTHING",
  "posId": "POS-00234",
  "currency": "MX"
}

### Service payment (ELECTRICITY, WATER, GAS or OTHER)
POST {{baseUrl}}/service-payment
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "amount": 875.50,
  "description": "March electricity bill",
  "sourceAccountNumber": "{{accountNumber}}",
  "paymentReference": "LUZ-RPT-20240317-0100",
  "serviceType": "ELECTRICITY",
  "currency": "MX"
}

### ATM withdrawal: the transactionFee is debited along with the amount (and refunded if reversed)
POST {{baseUrl}}/withdrawal
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "amount": 1000.00,
  "description": "ATM withdrawal",
  "sourceAccountNumber": "{{accountNumber}}",
  "atmLocation": "Av. Insurgentes Sur 1234, CDMX",
  "atmSessionId": "ATM-SESSION-20240118-4521",
  "receiptNumber": "RCP-20240118-0056",
  "transactionFee": 25.00,
  "currency": "MX",
  "securityVerificationMethod": "PIN",
  "withdrawalMethod": "DEBIT_CARD"
}

### Deposit (ADMIN only): cash at a branch, payroll... The target can be an ACCOUNT, CLABE or CARD;
### the transaction belongs to the owner of the account, who sees it in their history
POST {{baseUrl}}/deposit
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "amount": 5000.00,
  "description": "Cash deposit at branch",
  "targetIdentifier": "{{clabe}}",
  "targetIdentifierType": "CLABE",
  "currency": "MX"
}
