  "withdrawalMethod": "DEBIT_CARD"
}

### Transfer - CLABE a CLABE(ADMIN-CUSTOMER_BASIC)
POST {{baseUrl}}/transfer
Authorization: {{token}}
Content-Type: application/json

{
  "amount": 100.00,
  "description": "Pago con CLABE",
  "currency": "MX",
  "sourceIdentifier": "002010113717262634",
  "sourceIdentifierType": "CLABE",
  "targetIdentifier": "002180700148685530",
  "targetIdentifierType": "CLABE"
}

### Cancel - solo PENDING(ADMIN-CUSTOMER_BASIC dueño)
POST http://localhost:8000/api/v1/transaction/<transactionCode>/cancel
Authorization: {{token}}

### Reverse - solo COMPLETED(ADMIN)
POST http://localhost:8000/api/v1/transaction/<transactionCode>/reverse
Authorization: {{token}}
