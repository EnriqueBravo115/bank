# Descriptions of an account's COMPLETED transactions (by account number).
@baseUrl = http://localhost:8000/api/v1/transaction/support
@customerToken = PASTE_TOKEN_FROM_auth.http
@accountNumber = ACC-1774713408076

### Unique words of the descriptions (ADMIN, CUSTOMER_BASIC)
GET {{baseUrl}}/unique-descriptions/{{accountNumber}}
Authorization: Bearer {{customerToken}}

### All descriptions, comma separated (ADMIN, CUSTOMER_BASIC)
GET {{baseUrl}}/all-descriptions/{{accountNumber}}
Authorization: Bearer {{customerToken}}
