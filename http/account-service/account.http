# La cuenta se crea sola al terminar el KYC (evento de user-service), con saldo inicial 0.
# Los movimientos (/movement/transfer|purchase|service|withdrawal y /movement/{key}/reverse) solo los
# llama transaction-service con su token SERVICE y el header Idempotency-Key: usa transaction-service/.
@baseUrl = http://localhost:8000/api/v1/account
@customerToken = PEGA_AQUI_EL_TOKEN_DE_auth.http
@adminToken = PEGA_AQUI_EL_TOKEN_DE_auth.http
@accountNumber = ACC-1774713408076
@clabe = 002010113717262634
@cardNumber = 4123450000000001

### Mi cuenta (CUSTOMER_BASIC)
GET {{baseUrl}}/me
Authorization: Bearer {{customerToken}}

### Cuenta por número (ADMIN, SERVICE)
GET {{baseUrl}}/get-by-account-number/{{accountNumber}}
Authorization: Bearer {{adminToken}}

### Cuenta por CLABE (ADMIN, SERVICE)
GET {{baseUrl}}/get-by-clabe/{{clabe}}
Authorization: Bearer {{adminToken}}

### Cuenta de una tarjeta (ADMIN, SERVICE)
GET {{baseUrl}}/get-by-card-number/{{cardNumber}}
Authorization: Bearer {{adminToken}}

### Cuenta por email (ADMIN)
GET {{baseUrl}}/get-by-email/ana.martinez92@gmail.com
Authorization: Bearer {{adminToken}}
