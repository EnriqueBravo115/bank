# The account is created when the KYC step finishes (user-service event), with an opening balance of 0.
# Movements (/movement/transfer|purchase|service|withdrawal and /movement/{key}/reverse) are only called
# by transaction-service with its SERVICE token and the Idempotency-Key header: use transaction-service/.
@baseUrl = http://localhost:8000/api/v1/account
@customerToken = PASTE_TOKEN_FROM_auth.http
@adminToken = PASTE_TOKEN_FROM_auth.http
@accountNumber = ACC-1774713408076
@clabe = 002010113717262634
@cardNumber = 4123450000000001

### My account (CUSTOMER_BASIC)
GET {{baseUrl}}/me
Authorization: Bearer {{customerToken}}

### Account by number (ADMIN, SERVICE)
GET {{baseUrl}}/get-by-account-number/{{accountNumber}}
Authorization: Bearer {{adminToken}}

### Account by CLABE (ADMIN, SERVICE)
GET {{baseUrl}}/get-by-clabe/{{clabe}}
Authorization: Bearer {{adminToken}}

### Account of a card (ADMIN, SERVICE)
GET {{baseUrl}}/get-by-card-number/{{cardNumber}}
Authorization: Bearer {{adminToken}}

### Account by email (ADMIN)
GET {{baseUrl}}/get-by-email/ana.martinez92@gmail.com
Authorization: Bearer {{adminToken}}
